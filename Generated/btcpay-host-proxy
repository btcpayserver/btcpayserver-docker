#!/bin/bash
set -euo pipefail

json="$(</dev/stdin)"
if ! jq -e -s '
    length == 1 and
    (.[0] | type == "array") and
    all(.[0][]; type == "string" and (explode | all(. != 0)))
' > /dev/null <<< "$json"; then
    printf 'Expected exactly one JSON array containing only strings\n' >&2
    exit 1
fi

mapfile -d '' -t args < <(jq -j -s '.[0][] | ., "\u0000"' <<< "$json")
exec btcpay-host "${args[@]}"
