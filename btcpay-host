#!/bin/bash

set -euo pipefail

if [ -f "/etc/profile.d/btcpay-env.sh" ]; then
    # shellcheck source=/dev/null
    . "/etc/profile.d/btcpay-env.sh"
fi

authorized_keys="/root/.ssh/authorized_keys"
ssh_dir="$(dirname "$authorized_keys")"
allowed_commands=(env help changedomain update clean restart)

json_string() {
    jq -Rs .
}

json_null() {
    printf 'null\n'
}

run_detached() {
    if [ -t 1 ]; then
        "$@"
        return
    fi

    # The SSH client lives in a container these commands can restart. Only the
    # log follower should depend on that connection, not the maintenance work.
    local log="$BTCPAY_BASE_DIRECTORY/btcpay-host-$command.log"
    local pid status=0
    install -m 600 /dev/null "$log"
    # Keep the update script's first-update fallback from detaching a second time.
    BTCPAY_UPDATE_DETACHED=1 setsid "$@" > "$log" 2>&1 < /dev/null &
    pid=$!
    tail -n +1 -f --pid="$pid" "$log" || true
    wait "$pid" || status=$?
    return "$status"
}

print_help() {
    cat <<EOF
Usage: btcpay-host <command> [arguments]

Commands:
  env                   Return deployment metadata and supported host commands as JSON.
  help                  Show this help.
  showauthorizedkeys    Return authorized SSH public keys as JSON.
  setauthorizedkeys     Replace authorized SSH public keys with argument 1.
  changedomain <domain> Change the BTCPay Server domain.
  update                Update BTCPay Server.
  clean                 Clean unused host resources.
  restart               Restart BTCPay Server and related services.
EOF
}

command="${1:-}"
if [ -z "$command" ]; then
    print_help
    exit 0
fi

command_allowed=false
for allowed_command in "${allowed_commands[@]}"; do
    if [ "$command" == "$allowed_command" ]; then
        command_allowed=true
        break
    fi
done

if [ "$command_allowed" != true ]; then
    echo "Unknown btcpay-host command: $command" >&2
    exit 1
fi

case "$command" in
    env)
        if routes="$(btcpay-routes show 2>/dev/null)"; then
            printf '%s\n' "${allowed_commands[@]}" | jq -Rsc --argjson routes "$routes" \
                '{deploymentType:"btcpayserver-docker",commands:(split("\n")[:-1]),routes:$routes}'
        else
            printf '%s\n' "${allowed_commands[@]}" | jq -Rsc \
                '{deploymentType:"btcpayserver-docker",commands:(split("\n")[:-1])}'
        fi
        ;;
    help)
        print_help
        ;;
    showauthorizedkeys)
        if [ -f "$authorized_keys" ]; then
            json_string < "$authorized_keys"
        else
            printf '""\n'
        fi
        ;;
    setauthorizedkeys)
        mkdir -p "$ssh_dir"
        chmod 700 "$ssh_dir"
        if [ ! -f "$authorized_keys" ]; then
            touch "$authorized_keys"
            chmod 600 "$authorized_keys"
        fi
        printf '%s' "${2:-}" > "$authorized_keys"
        json_null
        ;;
    changedomain)
        if [ "$#" -ne 2 ] || [[ ! "$2" =~ ^([a-z0-9]+(-[a-z0-9]+)*\.)+[a-z]{2,}$ ]]; then
            echo "The domain must be a valid domain name without a protocol." >&2
            exit 1
        fi
        run_detached changedomain.sh "${2:-}"
        ;;
    update)
        run_detached btcpay-update.sh
        ;;
    clean)
        btcpay-clean.sh
        ;;
    restart)
        run_detached btcpay-restart.sh
        ;;
esac
