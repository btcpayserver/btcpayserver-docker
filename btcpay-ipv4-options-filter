#!/bin/bash

set -Eeuo pipefail

if [ -z "${BTCPAY_BASE_DIRECTORY:-}" ] && [ -f "/etc/profile.d/btcpay-env.sh" ]; then
    # shellcheck source=/dev/null
    . "/etc/profile.d/btcpay-env.sh"
fi

print_help() {
    cat <<EOF
Usage: btcpay-ipv4-options-filter <command>

Drop inbound IPv4 TCP packets that carry IP options, a stopgap for
CVE-2026-98432 until the host runs a patched kernel. btcpay-setup.sh and btcpay-update.sh
enable it unless it was disabled before or BTCPAY_IPV4_OPTIONS_FILTER is false.
While enabled, BTCPay Server restores the filter whenever it starts, including
after a reboot.

Commands:
  enable   Load the filter and record that it is enabled.
  disable  Remove the filter and record that it is disabled.
  status   Show whether the filter is enabled and loaded.
  help     Show this help.
EOF
}

filter_loaded() {
    local tables
    command -v nft > /dev/null 2>&1 || return 1
    # A failure must not read as "no table"; stderr only warns about Docker's iptables-nft rules.
    if ! tables="$(nft list tables ip 2> /dev/null)"; then
        echo "Error: nft could not list the IPv4 tables." >&2
        exit 1
    fi
    grep -qx 'table ip btcpay_ipv4_options' <<< "$tables"
}

command_name="${1:-}"
if [ -z "$command_name" ] || [ "$command_name" = "help" ]; then
    print_help
    exit 0
fi

if [ -z "${BTCPAY_BASE_DIRECTORY:-}" ]; then
    echo "BTCPAY_BASE_DIRECTORY is not set. Run this on a BTCPay Server host." >&2
    exit 1
fi
# shellcheck source=helpers.sh
. "$BTCPAY_BASE_DIRECTORY/btcpayserver-docker/helpers.sh"
flag_file="$(btcpay_ipv4_options_filter_flag)"

case "$command_name" in
    enable)
        btcpay_ipv4_options_filter_apply
        btcpay_ipv4_options_filter_record enabled
        echo "IPv4 options filter enabled."
        ;;
    disable)
        if filter_loaded; then
            nft delete table ip btcpay_ipv4_options
        elif ! command -v nft > /dev/null 2>&1 && [ "$(btcpay_ipv4_options_filter_state)" = enabled ]; then
            echo "Error: nft is required to remove the filter." >&2
            exit 1
        fi
        btcpay_ipv4_options_filter_record disabled
        echo "IPv4 options filter disabled."
        ;;
    status)
        state=""
        since=""
        if [ -f "$flag_file" ]; then
            read -r state since < "$flag_file" || true
        fi
        case "$state" in
            enabled) echo "Enabled: yes, since $since" ;;
            disabled) echo "Enabled: no, disabled since $since" ;;
            *) echo "Enabled: no" ;;
        esac
        dropped=""
        if filter_loaded; then
            dropped="$(nft list chain ip btcpay_ipv4_options prerouting 2> /dev/null | sed -n 's/.* counter packets \([0-9]*\) .*drop comment "CVE-2026-98432".*/\1/p' || true)"
        fi
        if [ -n "$dropped" ]; then
            echo "Loaded: yes, $dropped packets dropped"
        else
            echo "Loaded: no"
        fi
        ;;
    *)
        echo "Unknown command: $command_name" >&2
        exit 1
        ;;
esac
